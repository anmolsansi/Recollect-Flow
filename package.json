{
  "name": "recollect-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --config vitest.node.config.ts && vitest run --config vitest.d1.config.ts",
    "check": "npm run format && npm run lint && npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply recollect-flow-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply recollect-flow-prod --remote"
  },
  "dependencies": {
    "hono": "^4.8.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.15",
    "eslint": "^10.8.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.116.0"
  },
  "engines": {
    "node": ">=22"
  }
}
