{
  "name": "recollect-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "bg30:evidence:test": "node --test scripts/bg30-evidence.test.mjs",
    "auth:rotation:test": "vitest run --config vitest.node.config.ts apps/worker-api/test/token-rotation.test.ts && vitest run --config vitest.d1.config.ts apps/worker-api/test/token-rotation.d1.spec.ts",
    "dev:api": "wrangler dev",
    "dev:web": "npm run dev -w apps/web",
    "web:build": "npm run build -w apps/web",
    "web:lint": "npm run lint -w apps/web",
    "web:test": "npm run test -w apps/web",
    "contracts:check": "npm run check -w packages/contracts",
    "deploy": "npm run release:package && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "release:smoke:test": "node --test scripts/verify-production-release.test.mjs",
    "recovery:bundle:test": "node --test scripts/recovery-bundle.test.mjs",
    "test": "npm run release:smoke:test && vitest run --config vitest.node.config.ts && vitest run --config vitest.d1.config.ts",
    "check": "npm run bg30:evidence:test && npm run recovery:bundle:test && npm run bg29:latency:test && npm run format && npm run lint && npm run typecheck && npm test && npm run contracts:check && npm run web:lint && npm run web:test && npm run web:build",
    "db:migrate:local": "wrangler d1 migrations apply recollect-flow-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply recollect-flow-prod --remote",
    "browser:capture:test": "node scripts/verify-browser-capture.mjs",
    "browser:follow-up:test": "node scripts/verify-browser-follow-up.mjs",
    "browser:file-upload:test": "node scripts/verify-browser-file-upload.mjs",
    "browser:recovery:test": "node scripts/verify-browser-recovery.mjs",
    "browser:download:test": "node scripts/verify-browser-download.mjs",
    "browser:source-recovery:test": "node scripts/verify-browser-source-recovery.mjs",
    "browser:workflow:test": "node scripts/verify-browser-workflow.mjs",
    "browser:acquisition:test": "node scripts/verify-browser-acquisition.mjs",
    "browser:operations:test": "node scripts/verify-browser-operations.mjs",
    "browser:digests:test": "node scripts/verify-browser-digests.mjs",
    "release:package": "node scripts/web-release.mjs clean && npm run web:build && node scripts/web-release.mjs finalize",
    "release:package:test": "node --test scripts/web-release.test.mjs",
    "browser:hosting:test": "node scripts/verify-web-hosting.mjs",
    "browser:hosting:remote:test": "node scripts/verify-remote-hosting.mjs",
    "bg29:latency:test": "node --test scripts/bg29-capture-bench.test.mjs",
    "bg29:latency:bench": "node scripts/run-bg29-capture-bench.mjs",
    "bg29:fts:smoke": "node scripts/bg29-fts-rebuild.mjs",
    "bg29:resource:profile": "npm run web:build && node scripts/bg29-worker-resource.mjs"
  },
  "dependencies": {
    "hono": "^4.8.10",
    "unpdf": "^1.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.15",
    "eslint": "^10.8.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.116.0"
  },
  "engines": {
    "node": ">=22"
  }
}
