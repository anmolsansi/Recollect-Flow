{
  "name": "recollect-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "dev:api": "wrangler dev",
    "dev:web": "npm run dev -w apps/web",
    "web:build": "npm run build -w apps/web",
    "web:lint": "npm run lint -w apps/web",
    "web:test": "npm run test -w apps/web",
    "contracts:check": "npm run check -w packages/contracts",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --config vitest.node.config.ts && vitest run --config vitest.d1.config.ts",
    "check": "npm run format && npm run lint && npm run typecheck && npm test && npm run contracts:check && npm run web:lint && npm run web:test && npm run web:build",
    "db:migrate:local": "wrangler d1 migrations apply recollect-flow-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply recollect-flow-prod --remote"
  },
  "dependencies": {
    "hono": "^4.8.10",
    "unpdf": "^1.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.15",
    "eslint": "^10.8.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.116.0"
  },
  "engines": {
    "node": ">=22"
  }
}
